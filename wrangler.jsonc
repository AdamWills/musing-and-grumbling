{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "musing-and-grumbling",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "lauramwiebe.com", "custom_domain": true },
    { "pattern": "www.lauramwiebe.com", "custom_domain": true }
  ]
}
